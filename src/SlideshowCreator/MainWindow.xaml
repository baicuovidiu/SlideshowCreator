<Window x:Class="SlideshowCreator.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Slideshow Creator 0.1.4" Width="1320" Height="820" MinWidth="980" MinHeight="640"
 Background="#101216" Foreground="White" AllowDrop="True" Drop="Window_Drop" PreviewDragOver="Window_PreviewDragOver">
 <Window.Resources>
  <Style x:Key="TopButton" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="4,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="SideButton" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#303640"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
 </Window.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="6"/><RowDefinition Height="200" MinHeight="100"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10">
   <StackPanel DockPanel.Dock="Left"><TextBlock Text="SLIDESHOW CREATOR" Foreground="#D6A95E" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="MVP 0.1.4" Foreground="#777"/></StackPanel>
   <WrapPanel HorizontalAlignment="Right"><Button Style="{StaticResource TopButton}" Background="#286A8E" Click="AddMedia_Click">+ FOTO / VIDEO</Button><Button Style="{StaticResource TopButton}" Background="#5E4B8B" Click="AddMusic_Click">+ MUZICĂ</Button><Button Style="{StaticResource TopButton}" Background="#4C7358" Click="Sort_Click">SORTARE CRONOLOGICĂ</Button></WrapPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="220"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="6"/><ColumnDefinition Width="255" MinWidth="210"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#181B20" Padding="8"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5,2,5,8"><TextBlock Text="MEDIA" FontWeight="Bold"/><TextBlock x:Name="CountText" Text="0 elemente" Foreground="#8C939E" Margin="12,0,0,0"/></StackPanel><ListView x:Name="MediaList" ItemsSource="{Binding Media}" SelectionChanged="MediaList_SelectionChanged" Background="#111318" Foreground="White" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Grid Margin="2,4"><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="68" Height="48" Background="#050607"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Type}" Foreground="#D6A95E"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></DockPanel></Border>
   <GridSplitter Grid.Column="1" Width="6" Background="#2B3038" HorizontalAlignment="Stretch"/>
   <Border Grid.Column="2" Background="Black"><Grid><Image x:Name="PhotoPreview" Stretch="Uniform" Visibility="Collapsed"/><MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed"/><Button x:Name="ImportDropZone" Click="AddMedia_Click" Background="#0E1115" BorderBrush="#2D3945" BorderThickness="2" Foreground="#AAB2BC" Margin="18"><StackPanel><TextBlock Text="+" FontSize="54" HorizontalAlignment="Center" Foreground="#D6A95E"/><TextBlock Text="IMPORTĂ FOTO / VIDEO" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="click aici sau trage fișierele în fereastră" Foreground="#707985" HorizontalAlignment="Center"/></StackPanel></Button></Grid></Border>
   <GridSplitter Grid.Column="3" Width="6" Background="#2B3038" HorizontalAlignment="Stretch"/>
   <Border Grid.Column="4" Background="#181B20" Padding="12"><StackPanel><TextBlock Text="PROPRIETĂȚI" FontWeight="Bold" Margin="0,0,0,14"/><TextBlock Text="Durată / Trim OUT (secunde)"/><TextBox x:Name="DurationBox" Text="4" Margin="0,4,0,10" LostFocus="Property_Changed"/><TextBlock Text="Trim IN (secunde)"/><TextBox x:Name="TrimInBox" Text="0" Margin="0,4,0,10" LostFocus="Property_Changed"/><CheckBox x:Name="MuteBox" Content="Dezactivează audio original" Margin="0,5,0,15" Click="Property_Changed"/><Button Style="{StaticResource SideButton}" Click="Preview_Click">PREVIEW SELECȚIE</Button><Button Style="{StaticResource SideButton}" Background="#713C3C" Click="Remove_Click">ELIMINĂ SELECȚIA</Button></StackPanel></Border>
  </Grid>
  <GridSplitter Grid.Row="2" Height="6" Background="#2B3038" HorizontalAlignment="Stretch"/>
  <Border Grid.Row="3" Background="#181B20" Margin="0,0,0,10" Padding="10"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBlock Text="TIMELINE" FontWeight="Bold"/><TextBlock x:Name="MusicLabel" Text="Fără muzică" Foreground="#999" Margin="25,0"/></StackPanel><ListBox ItemsSource="{Binding Media}" Background="#111318" Foreground="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="155" Height="118" Margin="3" Padding="6" Background="#292D33"><Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/><StackPanel Grid.Row="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Duration, StringFormat={}{0:0.0} sec}" Foreground="#D6A95E"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock x:Name="StatusText" Text="Pregătit" Foreground="#AAA"/><TextBlock x:Name="DetailStatusText" Foreground="#6F7782" Margin="12,0"/></StackPanel><ProgressBar x:Name="ExportProgress" Grid.Column="1" Height="10" Visibility="Collapsed"/><Button Grid.Column="2" Background="#A77834" Foreground="White" BorderThickness="0" Padding="24,10" Click="Export_Click" FontWeight="Bold">EXPORT MP4</Button></Grid>
 </Grid>
</Window>
