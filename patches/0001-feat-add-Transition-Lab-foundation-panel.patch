+TransitionLabDock::TransitionLabDock(QWidget *parent)
+    : QDockWidget(tr("Transition Lab"), parent)
+{
+    setObjectName(QStringLiteral("TransitionLabDock"));
+    setMinimumWidth(330);
+
+    auto *container = new QWidget(this);
+    auto *layout = new QVBoxLayout(container);
+
+    auto *title = new QLabel(tr("TRANSITION LAB 0.1.0"), container);
+    QFont titleFont = title->font();
+    titleFont.setBold(true);
+    titleFont.setPointSize(titleFont.pointSize() + 2);
+    title->setFont(titleFont);
+    layout->addWidget(title);
+
+    auto *importRow = new QHBoxLayout;
+    auto *photoButton = new QPushButton(tr("Import photos"), container);
+    auto *audioButton = new QPushButton(tr("Import music"), container);
+    importRow->addWidget(photoButton);
+    importRow->addWidget(audioButton);
+    layout->addLayout(importRow);
+
+    m_photoList = new QListWidget(container);
+    m_photoList->setViewMode(QListView::IconMode);
+    m_photoList->setIconSize(QSize(112, 72));
+    m_photoList->setResizeMode(QListView::Adjust);
+    m_photoList->setMovement(QListView::Snap);
+    m_photoList->setDragDropMode(QAbstractItemView::InternalMove);
+    m_photoList->setDefaultDropAction(Qt::MoveAction);
+    m_photoList->setSelectionMode(QAbstractItemView::ExtendedSelection);
+    m_photoList->setToolTip(tr("Drag thumbnails to change their order."));
+    layout->addWidget(m_photoList, 1);
+
+    auto *transitionBox = new QGroupBox(tr("Transition between photos"), container);
+    auto *transitionLayout = new QFormLayout(transitionBox);
+    auto *transition = new QComboBox(transitionBox);
+    transition->addItems({tr("Articulated panels"),
+                          tr("3D accordion"),
+                          tr("Rotating cubes"),
+                          tr("Rectangular mosaic"),
+                          tr("Four-zone mosaic"),
+                          tr("Vertical strips"),
+                          tr("Horizontal blinds"),
+                          tr("Offset slices"),
+                          tr("Radial aperture"),
+                          tr("Segmented ring"),
+                          tr("Diagonal shards"),
+                          tr("Photo wall"),
+                          tr("Floating frames"),
+                          tr("Frame fan"),
+                          tr("Depth blocks")});
+    auto *duration = new QDoubleSpinBox(transitionBox);
+    duration->setRange(0.20, 10.0);
+    duration->setValue(1.50);
+    duration->setSuffix(tr(" s"));
+    duration->setSingleStep(0.10);
+    auto *direction = new QComboBox(transitionBox);
+    direction->addItems({tr("Automatic"), tr("Left to right"), tr("Right to left"),
+                         tr("Top to bottom"), tr("Bottom to top")});
+    transitionLayout->addRow(tr("Family"), transition);
+    transitionLayout->addRow(tr("Duration"), duration);
+    transitionLayout->addRow(tr("Direction"), direction);
+    layout->addWidget(transitionBox);
+
+    auto *audioBox = new QGroupBox(tr("Music"), container);
+    auto *audioLayout = new QFormLayout(audioBox);
+    m_audioLabel = new QLabel(tr("No music selected"), audioBox);
+    m_audioLabel->setWordWrap(true);
+    m_fadeIn = new QDoubleSpinBox(audioBox);
+    m_fadeOut = new QDoubleSpinBox(audioBox);
+    for (auto *spinBox : {m_fadeIn, m_fadeOut}) {
+        spinBox->setRange(0.0, 30.0);
+        spinBox->setValue(2.0);
+        spinBox->setSuffix(tr(" s"));
+        spinBox->setSingleStep(0.25);
+    }
+    audioLayout->addRow(tr("File"), m_audioLabel);
+    audioLayout->addRow(tr("Fade In"), m_fadeIn);
+    audioLayout->addRow(tr("Fade Out"), m_fadeOut);
+    layout->addWidget(audioBox);
+
+    auto *diagnosticsBox = new QGroupBox(tr("Diagnostics"), container);
+    auto *diagnosticsLayout = new QVBoxLayout(diagnosticsBox);
+    m_diagnosticsLabel = new QLabel(diagnosticsBox);
+    m_diagnosticsLabel->setWordWrap(true);
+    diagnosticsLayout->addWidget(m_diagnosticsLabel);
+    layout->addWidget(diagnosticsBox);
+
+    auto *exportButton = new QPushButton(tr("Export MP4 Full HD"), container);
+    exportButton->setEnabled(false);
+    exportButton->setToolTip(tr("Enabled after the export pipeline validation succeeds."));
+    layout->addWidget(exportButton);
+
+    setWidget(container);
+    connect(photoButton, &QPushButton::clicked, this, [this] { importPhotos(); });
+    connect(audioButton, &QPushButton::clicked, this, [this] { importAudio(); });
+    refreshDiagnostics();
+}
+
+QStringList TransitionLabDock::photoFiles() const
+{
+    QStringList result;
+    for (int row = 0; row < m_photoList->count(); ++row)
+        result << m_photoList->item(row)->data(Qt::UserRole).toString();
+    return result;
+}
+
+double TransitionLabDock::fadeInSeconds() const
+{
+    return m_fadeIn->value();
+}
+
+double TransitionLabDock::fadeOutSeconds() const
+{
+    return m_fadeOut->value();
+}
+
+void TransitionLabDock::importPhotos()
+{
+    const QStringList files = QFileDialog::getOpenFileNames(
+        this, tr("Import photos"), QString(), tr("Photos (*.jpg *.jpeg *.png)"));
+    for (const QString &file : files) {
+        auto *item = new QListWidgetItem(QIcon(file), QFileInfo(file).fileName());
+        item->setData(Qt::UserRole, file);
+        item->setToolTip(file);
+        m_photoList->addItem(item);
+    }
+}
+
+void TransitionLabDock::importAudio()
+{
+    const QString file = QFileDialog::getOpenFileName(
+        this, tr("Import music"), QString(), tr("Audio (*.mp3 *.wav *.m4a *.aac *.flac *.ogg)"));
+    if (file.isEmpty())
+        return;
+    m_audioFile = file;
+    m_audioLabel->setText(QFileInfo(file).fileName());
+    m_audioLabel->setToolTip(file);
+}
+
+void TransitionLabDock::refreshDiagnostics()
+{
+    const QString cpu = QSysInfo::currentCpuArchitecture();
+    const int threads = QThread::idealThreadCount();
+    m_diagnosticsLabel->setText(
+        tr("CPU: %1 (%2 threads)\nGPU: detection pending\nRAM: detection pending\n"
+           "Encoder: NVIDIA NVENC preferred; software fallback must be reported\nFPS: 25 / 30")
+            .arg(cpu)
+            .arg(threads));
+}
