+void MainWindow::applyTransitionLabMode()
+{
+    m_transitionLabDock = new TransitionLabDock(this);
+    addDockWidget(Qt::LeftDockWidgetArea, m_transitionLabDock);
+    m_transitionLabDock->show();
+
+    const QList<QDockWidget *> hiddenDocks = {m_propertiesDock,
+                                              m_playlistDock,
+                                              m_filtersDock,
+                                              m_notesDock,
+                                              m_subtitlesDock,
+                                              m_recentDock,
+                                              m_historyDock,
+                                              m_filesDock,
+                                              m_elementsDock,
+                                              m_keyframesDock,
+                                              m_markersDock};
+    for (QDockWidget *dock : hiddenDocks) {
+        if (dock) {
+            dock->hide();
+            dock->toggleViewAction()->setVisible(false);
+        }
+    }
+
+    m_timelineDock->show();
+    m_encodeDock->show();
+    m_jobsDock->show();
+    ui->menuView->setVisible(false);
+    ui->menuHelp->setVisible(false);
+    ui->actionOpenOther->setVisible(false);
+    ui->actionScreenRecording->setVisible(false);
+    ui->actionScreenSnapshot->setVisible(false);
+    ui->actionSubtitles->setVisible(false);
+}
