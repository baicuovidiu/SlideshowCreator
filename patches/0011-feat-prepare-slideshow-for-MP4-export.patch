Subject: [PATCH] feat: prepare slideshow for MP4 export

---
 src/docks/transitionlabdock.cpp | 17 +++++++++++++----
 src/docks/transitionlabdock.h   |  3 +++
 src/mainwindow.cpp              |  9 +++++++++
 3 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/src/docks/transitionlabdock.cpp b/src/docks/transitionlabdock.cpp
index 4372be4..967cd6d 100644
--- a/src/docks/transitionlabdock.cpp
+++ b/src/docks/transitionlabdock.cpp
@@ -134,15 +134,16 @@ TransitionLabDock::TransitionLabDock(QWidget *parent)
     m_previewButton->setEnabled(false);
     layout->addWidget(m_previewButton);
 
-    auto *exportButton = new QPushButton(tr("Export MP4 Full HD"), container);
-    exportButton->setEnabled(false);
-    exportButton->setToolTip(tr("Enabled after the export pipeline validation succeeds."));
-    layout->addWidget(exportButton);
+    m_exportButton = new QPushButton(tr("Prepare MP4 export"), container);
+    m_exportButton->setEnabled(false);
+    m_exportButton->setToolTip(tr("Build the slideshow and open the verified Shotcut export panel."));
+    layout->addWidget(m_exportButton);
 
     setWidget(container);
     connect(photoButton, &QPushButton::clicked, this, [this] { importPhotos(); });
     connect(audioButton, &QPushButton::clicked, this, [this] { importAudio(); });
     connect(m_previewButton, &QPushButton::clicked, this, &TransitionLabDock::previewSlideshow);
+    connect(m_exportButton, &QPushButton::clicked, this, &TransitionLabDock::prepareExport);
     connect(m_photoList, &QListWidget::currentRowChanged, this, [this](int row) {
         if (m_editedRow >= 0)
             storeTransitionForRow(m_editedRow);
@@ -248,6 +249,7 @@ void TransitionLabDock::updateTransitionEditor()
     m_transitionDuration->setEnabled(hasFollowingPhoto);
     m_transitionDirection->setEnabled(hasFollowingPhoto);
     m_previewButton->setEnabled(m_photoList->count() >= 2);
+    m_exportButton->setEnabled(m_photoList->count() >= 2);
     if (hasFollowingPhoto) {
         m_transitionTargetLabel->setText(
             tr("%1  →  %2").arg(m_photoList->item(row)->text(), m_photoList->item(row + 1)->text()));
@@ -322,6 +324,13 @@ void TransitionLabDock::previewSlideshow()
         emit previewRequested(slideshow);
 }
 
+void TransitionLabDock::prepareExport()
+{
+    Mlt::Playlist *slideshow = createSlideshow();
+    if (slideshow)
+        emit exportRequested(slideshow);
+}
+
 void TransitionLabDock::importAudio()
 {
     const QString file = QFileDialog::getOpenFileName(
diff --git a/src/docks/transitionlabdock.h b/src/docks/transitionlabdock.h
index 7bffca2..dc478c8 100644
--- a/src/docks/transitionlabdock.h
+++ b/src/docks/transitionlabdock.h
@@ -49,6 +49,7 @@ public:
 
 signals:
     void previewRequested(Mlt::Playlist *slideshow);
+    void exportRequested(Mlt::Playlist *slideshow);
 
 private:
     void importPhotos();
@@ -59,6 +60,7 @@ private:
     void updateTransitionEditor();
     Mlt::Playlist *createSlideshow() const;
     void previewSlideshow();
+    void prepareExport();
 
     QListWidget *m_photoList{nullptr};
     QLabel *m_audioLabel{nullptr};
@@ -71,6 +73,7 @@ private:
     QSlider *m_volume{nullptr};
     QLabel *m_transitionTargetLabel{nullptr};
     QPushButton *m_previewButton{nullptr};
+    QPushButton *m_exportButton{nullptr};
     QString m_audioFile;
     int m_editedRow{-1};
     bool m_loadingTransition{false};
diff --git a/src/mainwindow.cpp b/src/mainwindow.cpp
index fb69d0b..5207c2f 100644
--- a/src/mainwindow.cpp
+++ b/src/mainwindow.cpp
@@ -279,6 +279,15 @@ void MainWindow::applyTransitionLabMode()
             &TransitionLabDock::previewRequested,
             this,
             [this](Mlt::Playlist *slideshow) { open(slideshow, false); });
+    connect(m_transitionLabDock,
+            &TransitionLabDock::exportRequested,
+            this,
+            [this](Mlt::Playlist *slideshow) {
+                open(slideshow, false);
+                m_encodeDock->show();
+                m_encodeDock->raise();
+                m_encodeDock->onProducerOpened();
+            });
 
     const QList<QDockWidget *> hiddenDocks = {m_propertiesDock,
                                               m_playlistDock,
