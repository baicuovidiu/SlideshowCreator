 private:
     void importPhotos();
@@ -58,7 +58,7 @@ private:
     void loadTransitionForRow(int row);
     void storeTransitionForRow(int row);
     void updateTransitionEditor();
-    Mlt::Playlist *createSlideshow() const;
+    Mlt::Producer *createSlideshow() const;
