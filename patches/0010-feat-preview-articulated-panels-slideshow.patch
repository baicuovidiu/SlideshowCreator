+Mlt::Playlist *TransitionLabDock::createSlideshow() const
+{
+    const QStringList photos = photoFiles();
+    if (photos.size() < 2)
+        return nullptr;
+
+    const int framesPerPhoto = qRound(5.0 * MLT.profile().fps());
+    auto *slideshow = new Mlt::Playlist(MLT.profile());
+    for (const QString &photo : photos) {
+        Mlt::Producer producer(MLT.profile(), photo.toUtf8().constData());
+        if (!producer.is_valid()) {
+            delete slideshow;
+            return nullptr;
+        }
+        producer.set("length", framesPerPhoto);
+        producer.set_in_and_out(0, framesPerPhoto - 1);
+        slideshow->append(producer, 0, framesPerPhoto - 1);
+    }
+
+    const QList<TransitionSpec> specs = transitionSpecs();
+    int clipIndex = 0;
+    for (int pair = 0; pair < specs.size(); ++pair, ++clipIndex) {
+        const TransitionSpec &spec = specs.at(pair);
+        if (spec.family != 0)
+            continue;
+
+        int transitionFrames = qRound(spec.durationSeconds * MLT.profile().fps());
+        transitionFrames = qMin(transitionFrames, framesPerPhoto / 2 - 1);
+        if (transitionFrames < 2)
+            continue;
+
+        slideshow->mix(clipIndex, transitionFrames);
+        QScopedPointer<Mlt::Producer> mixedClip(slideshow->get_clip(clipIndex + 1));
+        if (mixedClip.isNull())
+            break;
+        mixedClip->parent().set(kShotcutTransitionProperty, "transitionLabPanels");
+
+        Mlt::Transition audioMix(MLT.profile(), "mix:-2");
+        slideshow->mix_add(clipIndex + 1, &audioMix);
+
+        Mlt::Transition panels(MLT.profile(), "frei0r.transitionlab_panels");
+        if (!panels.is_valid()) {
+            delete slideshow;
+            return nullptr;
+        }
+        const int variant = spec.direction == 0 ? pair % 4 : spec.direction - 1;
+        panels.anim_set("0", 0.0, 0);
+        panels.anim_set("0", 1.0, transitionFrames - 1);
+        panels.set("1", (variant + 0.5) / 4.0);
+        panels.set("2", 0.34);
+        slideshow->mix_add(clipIndex + 1, &panels);
+
+        ++clipIndex;
+    }
+    return slideshow;
+}
+
+void TransitionLabDock::previewSlideshow()
+{
+    Mlt::Playlist *slideshow = createSlideshow();
+    if (slideshow)
+        emit previewRequested(slideshow);
+}
